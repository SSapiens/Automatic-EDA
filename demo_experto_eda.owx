<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/eda/ontologies/demo_experto"
         xmlns="http://www.semanticweb.org/eda/ontologies/demo_experto#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="http://www.semanticweb.org/eda/ontologies/demo_experto"/>

<owl:ObjectProperty rdf:about="#sugiereTecnica"/>

<owl:ObjectProperty rdf:about="#tieneRecomendacion"/>

<owl:DatatypeProperty rdf:about="#tieneCardinalidad">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#tieneRatioDominante">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#ColumnaCategorica">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ColumnaBinaria">
  <rdfs:subClassOf rdf:resource="#ColumnaCategorica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColumnaCategorica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneCardinalidad"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#ColumnaCardinalidadBaja">
  <rdfs:subClassOf rdf:resource="#ColumnaCategorica"/>
</owl:Class>

<owl:Class rdf:about="#ColumnaCardinalidadAlta">
  <rdfs:subClassOf rdf:resource="#ColumnaCategorica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColumnaCategorica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneCardinalidad"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</xsd:minExclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#TecnicaVisualizacion">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#GraficoTorta">
  <rdfs:subClassOf rdf:resource="#TecnicaVisualizacion"/>
</owl:Class>

<owl:Class rdf:about="#GraficoBarras">
  <rdfs:subClassOf rdf:resource="#TecnicaVisualizacion"/>
</owl:Class>

<owl:Class rdf:about="#GraficoTreemap">
  <rdfs:subClassOf rdf:resource="#TecnicaVisualizacion"/>
</owl:Class>

<owl:Class rdf:about="#Recomendacion">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#AgruparCategorias">
  <rdfs:subClassOf rdf:resource="#Recomendacion"/>
</owl:Class>

<owl:Class rdf:about="#NoInformativa">
  <rdfs:subClassOf rdf:resource="#Recomendacion"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#indTorta">
  <rdf:type rdf:resource="#GraficoTorta"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#indBarras">
  <rdf:type rdf:resource="#GraficoBarras"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#indTreemap">
  <rdf:type rdf:resource="#GraficoTreemap"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#indAgrupar">
  <rdf:type rdf:resource="#AgruparCategorias"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#indNoInformativa">
  <rdf:type rdf:resource="#NoInformativa"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ejemplo_Sexo">
  <rdf:type rdf:resource="#ColumnaCategorica"/>
  <tieneCardinalidad rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</tieneCardinalidad>
  <tieneRatioDominante rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.52</tieneRatioDominante>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ejemplo_ID_Cliente">
  <rdf:type rdf:resource="#ColumnaCategorica"/>
  <tieneCardinalidad rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">200</tieneCardinalidad>
  <tieneRatioDominante rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.01</tieneRatioDominante>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ejemplo_Medicamento">
  <rdf:type rdf:resource="#ColumnaCategorica"/>
  <tieneCardinalidad rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</tieneCardinalidad>
  <tieneRatioDominante rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.45</tieneRatioDominante>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ejemplo_VariableDominante">
  <rdf:type rdf:resource="#ColumnaCategorica"/>
  <tieneCardinalidad rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</tieneCardinalidad>
  <tieneRatioDominante rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.85</tieneRatioDominante>
</owl:NamedIndividual>

<swrl:Variable rdf:about="urn:swrl#c"/>

<swrl:Variable rdf:about="urn:swrl#n"/>

<swrl:Variable rdf:about="urn:swrl#r"/>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#ColumnaCategorica"/>
          <swrl:argument1 rdf:resource="urn:swrl#c"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#tieneRatioDominante"/>
              <swrl:argument1 rdf:resource="urn:swrl#c"/>
              <swrl:argument2 rdf:resource="urn:swrl#r"/>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:BuiltinAtom>
                  <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/>
                  <swrl:arguments>
                    <rdf:Description>
                      <rdf:first rdf:resource="urn:swrl#r"/>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.8</rdf:first>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </swrl:arguments>
                </swrl:BuiltinAtom>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#tieneRecomendacion"/>
          <swrl:argument1 rdf:resource="urn:swrl#c"/>
          <swrl:argument2 rdf:resource="#indNoInformativa"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
</swrl:Imp>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#ColumnaCategorica"/>
          <swrl:argument1 rdf:resource="urn:swrl#c"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#tieneCardinalidad"/>
              <swrl:argument1 rdf:resource="urn:swrl#c"/>
              <swrl:argument2 rdf:resource="urn:swrl#n"/>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:BuiltinAtom>
                  <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/>
                  <swrl:arguments>
                    <rdf:Description>
                      <rdf:first rdf:resource="urn:swrl#n"/>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</rdf:first>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </swrl:arguments>
                </swrl:BuiltinAtom>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#tieneRecomendacion"/>
          <swrl:argument1 rdf:resource="urn:swrl#c"/>
          <swrl:argument2 rdf:resource="#indAgrupar"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
</swrl:Imp>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#ColumnaCategorica"/>
          <swrl:argument1 rdf:resource="urn:swrl#c"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#tieneCardinalidad"/>
              <swrl:argument1 rdf:resource="urn:swrl#c"/>
              <swrl:argument2 rdf:resource="urn:swrl#n"/>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:BuiltinAtom>
                  <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/>
                  <swrl:arguments>
                    <rdf:Description>
                      <rdf:first rdf:resource="urn:swrl#n"/>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</rdf:first>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </swrl:arguments>
                </swrl:BuiltinAtom>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#sugiereTecnica"/>
          <swrl:argument1 rdf:resource="urn:swrl#c"/>
          <swrl:argument2 rdf:resource="#indTreemap"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
</swrl:Imp>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#ColumnaCategorica"/>
          <swrl:argument1 rdf:resource="urn:swrl#c"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#tieneCardinalidad"/>
              <swrl:argument1 rdf:resource="urn:swrl#c"/>
              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</swrl:argument2>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#sugiereTecnica"/>
          <swrl:argument1 rdf:resource="urn:swrl#c"/>
          <swrl:argument2 rdf:resource="#indTorta"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
