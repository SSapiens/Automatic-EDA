<?xml version="1.0"?>
<!--
  ============================================================
  ONTOLOGÍA EDA — Variables Categóricas  v2.0
  Alineada con ontology_engine.py (owlready2 backend)

  Cambios respecto a v1:
    - tieneRatioNulos    (era tieneProporcionNulos)
    - tieneTotalRegistros añadida
    - tieneRatioDominante → xsd:decimal  (Python float)
    - tieneRatioNulos    → xsd:decimal
    - Individuos renombrados para coincidir con INDIVIDUAL_LABELS:
        indTorta        → indTortaPastel
        indBarras       → indBarrasVertical  +  indBarrasHorizontal (nuevo)
        indAgrupar      → indAgruparMinoritarias
        indNoInformativa→ indNoInformativa (igual)
      Nuevos: indFrecuenciaAcumulada, indAptoSegmentacion,
              indAlertaNulos, indAlertaDominante,
              indDistBalanceada, indDistDesbalanceada,
              indDistMuyDesbalanceada, indDistLevDesbalanceada
    - Clases de distribución y segmentación añadidas con
      owl:equivalentClass para activar la inferencia Pellet:
        DistribucionBalanceada, DistribucionLevementeDesbalanceada,
        DistribucionDesbalanceada, DistribucionMuyDesbalanceada,
        AlertaNulosAltos, AlertaCategoriaDominante,
        AptoParaSegmentacion, NoInformativaParaSegmentacion,
        AgruparCategoriasMinoritarias
    - ColumnaCardinalidadMuyAlta añadida (>100)
    - Reglas SWRL S1–S6 actualizadas + SQWRL QS1–QS6 + Q1–Q5
  ============================================================
-->
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/eda/ontologies/demo_experto"
         xmlns="http://www.semanticweb.org/eda/ontologies/demo_experto#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
         xmlns:sqwrl="http://swrl.stanford.edu/ontologies/built-ins/3.3/sqwrl.owl#">

<owl:Ontology rdf:about="http://www.semanticweb.org/eda/ontologies/demo_experto">
  <rdfs:comment>Ontología experta para EDA de variables categóricas. v2.0</rdfs:comment>
</owl:Ontology>


<!-- ============================================================
     PROPIEDADES DE OBJETO
     ============================================================ -->

<owl:ObjectProperty rdf:about="#sugiereTecnica">
  <rdfs:domain rdf:resource="#ColumnaCategorica"/>
  <rdfs:range  rdf:resource="#TecnicaVisualizacion"/>
  <rdfs:comment>Relaciona una columna con una técnica de visualización sugerida.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#tieneRecomendacion">
  <rdfs:domain rdf:resource="#ColumnaCategorica"/>
  <rdfs:range  rdf:resource="#Recomendacion"/>
  <rdfs:comment>Relaciona una columna con una recomendación de preprocesado o análisis.</rdfs:comment>
</owl:ObjectProperty>


<!-- ============================================================
     PROPIEDADES DE DATO
     Nombres exactos que usa el backend ontology_engine.py
     ============================================================ -->

<!-- tieneCardinalidad: número de valores únicos (int) -->
<owl:DatatypeProperty rdf:about="#tieneCardinalidad">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ColumnaCategorica"/>
  <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment>Número de categorías únicas en la columna.</rdfs:comment>
</owl:DatatypeProperty>

<!-- tieneTotalRegistros: total de filas del dataset (int) -->
<owl:DatatypeProperty rdf:about="#tieneTotalRegistros">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ColumnaCategorica"/>
  <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment>Total de registros del dataset (len del DataFrame).</rdfs:comment>
</owl:DatatypeProperty>

<!-- tieneRatioDominante: proporción de la categoría más frecuente [0,1] (double) -->
<owl:DatatypeProperty rdf:about="#tieneRatioDominante">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ColumnaCategorica"/>
  <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment>Ratio de frecuencia de la categoría dominante (value_counts normalize iloc[0]).</rdfs:comment>
</owl:DatatypeProperty>

<!-- tieneRatioNulos: proporción de valores nulos [0,1] (double) — era tieneProporcionNulos -->
<owl:DatatypeProperty rdf:about="#tieneRatioNulos">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ColumnaCategorica"/>
  <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment>Ratio de valores nulos (isnull().mean()). Nombre exacto esperado por ontology_engine.py.</rdfs:comment>
</owl:DatatypeProperty>


<!-- ============================================================
     JERARQUÍA DE CLASES — Columnas
     ============================================================ -->

<owl:Class rdf:about="#ColumnaCategorica">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment>Clase raíz: cualquier columna de tipo categórico analizable.</rdfs:comment>
</owl:Class>

<!-- ColumnaBinaria: exactamente 2 categorías -->
<owl:Class rdf:about="#ColumnaBinaria">
  <rdfs:subClassOf rdf:resource="#ColumnaCategorica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColumnaCategorica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneCardinalidad"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment>Columna con exactamente 2 valores únicos.</rdfs:comment>
</owl:Class>

<!-- ColumnaCardinalidadBaja: 3–14 categorías -->
<owl:Class rdf:about="#ColumnaCardinalidadBaja">
  <rdfs:subClassOf rdf:resource="#ColumnaCategorica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColumnaCategorica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneCardinalidad"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions rdf:parseType="Collection">
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</xsd:minInclusive>
                </rdf:Description>
                <rdf:Description>
                  <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</xsd:maxInclusive>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment>Columna con 3 a 14 categorías únicas.</rdfs:comment>
</owl:Class>

<!-- ColumnaCardinalidadAlta: 15–100 categorías -->
<owl:Class rdf:about="#ColumnaCardinalidadAlta">
  <rdfs:subClassOf rdf:resource="#ColumnaCategorica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColumnaCategorica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneCardinalidad"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions rdf:parseType="Collection">
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</xsd:minInclusive>
                </rdf:Description>
                <rdf:Description>
                  <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100</xsd:maxInclusive>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment>Columna con 15 a 100 categorías únicas.</rdfs:comment>
</owl:Class>

<!-- ColumnaCardinalidadMuyAlta: >100 categorías (ID-like) -->
<owl:Class rdf:about="#ColumnaCardinalidadMuyAlta">
  <rdfs:subClassOf rdf:resource="#ColumnaCategorica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColumnaCategorica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneCardinalidad"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions rdf:parseType="Collection">
                <rdf:Description>
                  <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100</xsd:minExclusive>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment>Columna con más de 100 categorías únicas. Probablemente un ID o código libre.</rdfs:comment>
</owl:Class>


<!-- ============================================================
     JERARQUÍA DE CLASES — Distribución
     Activadas por Pellet vía owl:equivalentClass con restricciones
     sobre tieneRatioDominante
     ============================================================ -->

<owl:Class rdf:about="#DistribucionCategorica">
  <rdfs:subClassOf rdf:resource="#ColumnaCategorica"/>
  <rdfs:comment>Clase base para perfiles de distribución de frecuencias.</rdfs:comment>
</owl:Class>

<!-- Balanceada: ratio dominante ≤ 0.4 -->
<owl:Class rdf:about="#DistribucionBalanceada">
  <rdfs:subClassOf rdf:resource="#DistribucionCategorica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColumnaCategorica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneRatioDominante"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions rdf:parseType="Collection">
                <rdf:Description>
                  <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</xsd:maxInclusive>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment>Ratio dominante ≤ 0.4: distribución relativamente equilibrada.</rdfs:comment>
</owl:Class>

<!-- LevementeDesbalanceada: ratio dominante en (0.4, 0.6] -->
<owl:Class rdf:about="#DistribucionLevementeDesbalanceada">
  <rdfs:subClassOf rdf:resource="#DistribucionCategorica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColumnaCategorica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneRatioDominante"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions rdf:parseType="Collection">
                <rdf:Description>
                  <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</xsd:minExclusive>
                </rdf:Description>
                <rdf:Description>
                  <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.6</xsd:maxInclusive>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment>Ratio dominante en (0.4, 0.6]: leve desbalance.</rdfs:comment>
</owl:Class>

<!-- Desbalanceada: ratio dominante en (0.6, 0.8] -->
<owl:Class rdf:about="#DistribucionDesbalanceada">
  <rdfs:subClassOf rdf:resource="#DistribucionCategorica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColumnaCategorica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneRatioDominante"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions rdf:parseType="Collection">
                <rdf:Description>
                  <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.6</xsd:minExclusive>
                </rdf:Description>
                <rdf:Description>
                  <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.8</xsd:maxInclusive>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment>Ratio dominante en (0.6, 0.8]: desbalance notable.</rdfs:comment>
</owl:Class>

<!-- MuyDesbalanceada: ratio dominante > 0.8 -->
<owl:Class rdf:about="#DistribucionMuyDesbalanceada">
  <rdfs:subClassOf rdf:resource="#DistribucionCategorica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColumnaCategorica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneRatioDominante"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions rdf:parseType="Collection">
                <rdf:Description>
                  <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.8</xsd:minExclusive>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment>Ratio dominante > 0.8: una categoría concentra casi todos los registros.</rdfs:comment>
</owl:Class>


<!-- ============================================================
     JERARQUÍA DE CLASES — Alertas
     Activadas por Pellet vía owl:equivalentClass
     ============================================================ -->

<!-- AlertaNulosAltos: ratio de nulos > 0.20 -->
<owl:Class rdf:about="#AlertaNulosAltos">
  <rdfs:subClassOf rdf:resource="#ColumnaCategorica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColumnaCategorica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneRatioNulos"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions rdf:parseType="Collection">
                <rdf:Description>
                  <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.2</xsd:minExclusive>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment>⚠ Alerta: ratio de nulos supera el 20%.</rdfs:comment>
</owl:Class>

<!-- AlertaCategoriaDominante: ratio dominante > 0.80 -->
<owl:Class rdf:about="#AlertaCategoriaDominante">
  <rdfs:subClassOf rdf:resource="#ColumnaCategorica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColumnaCategorica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneRatioDominante"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions rdf:parseType="Collection">
                <rdf:Description>
                  <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.8</xsd:minExclusive>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment>⚠ Alerta: una categoría representa más del 80% de los registros.</rdfs:comment>
</owl:Class>


<!-- ============================================================
     JERARQUÍA DE CLASES — Segmentación
     ============================================================ -->

<!-- AptoParaSegmentacion: cardinalidad 3–14 Y ratio dominante ≤ 0.8 -->
<owl:Class rdf:about="#AptoParaSegmentacion">
  <rdfs:subClassOf rdf:resource="#ColumnaCategorica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColumnaCardinalidadBaja"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneRatioDominante"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions rdf:parseType="Collection">
                <rdf:Description>
                  <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.8</xsd:maxInclusive>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment>✓ Apta para segmentación: cardinalidad baja y sin categoría dominante abrumadora.</rdfs:comment>
</owl:Class>

<!-- NoInformativaParaSegmentacion: ratio dominante > 0.80 -->
<owl:Class rdf:about="#NoInformativaParaSegmentacion">
  <rdfs:subClassOf rdf:resource="#ColumnaCategorica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColumnaCategorica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneRatioDominante"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions rdf:parseType="Collection">
                <rdf:Description>
                  <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.8</xsd:minExclusive>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment>✗ No informativa para segmentación por categoría dominante >80%.</rdfs:comment>
</owl:Class>

<!-- AgruparCategoriasMinoritarias: cardinalidad > 15 -->
<owl:Class rdf:about="#AgruparCategoriasMinoritarias">
  <rdfs:subClassOf rdf:resource="#ColumnaCategorica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColumnaCardinalidadAlta"/>
        <rdf:Description rdf:about="#ColumnaCategorica"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment>Cardinalidad ≥15: agrupar categorías con frecuencia &lt;5% en "Otros" antes de visualizar.</rdfs:comment>
</owl:Class>


<!-- ============================================================
     JERARQUÍA DE CLASES — Técnicas de visualización
     ============================================================ -->

<owl:Class rdf:about="#TecnicaVisualizacion">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#GraficoTortaPastel">
  <rdfs:subClassOf rdf:resource="#TecnicaVisualizacion"/>
  <rdfs:comment>Gráfico de torta/pastel. Adecuado para columnas binarias o de muy baja cardinalidad.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GraficoBarrasVertical">
  <rdfs:subClassOf rdf:resource="#TecnicaVisualizacion"/>
  <rdfs:comment>Gráfico de barras vertical. Recomendado para cardinalidad baja.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GraficoBarrasHorizontal">
  <rdfs:subClassOf rdf:resource="#TecnicaVisualizacion"/>
  <rdfs:comment>Gráfico de barras horizontal. Preferido cuando las etiquetas son largas o cardinalidad media.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GraficoFrecuenciaAcumulada">
  <rdfs:subClassOf rdf:resource="#TecnicaVisualizacion"/>
  <rdfs:comment>Curva de frecuencia acumulada (ECDF). Útil para analizar concentración de categorías.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GraficoTreemap">
  <rdfs:subClassOf rdf:resource="#TecnicaVisualizacion"/>
  <rdfs:comment>Treemap. Recomendado para alta cardinalidad donde barras se vuelven ilegibles.</rdfs:comment>
</owl:Class>


<!-- ============================================================
     JERARQUÍA DE CLASES — Recomendaciones de preprocesado
     ============================================================ -->

<owl:Class rdf:about="#Recomendacion">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#AgruparCategorias">
  <rdfs:subClassOf rdf:resource="#Recomendacion"/>
</owl:Class>

<owl:Class rdf:about="#NoInformativa">
  <rdfs:subClassOf rdf:resource="#Recomendacion"/>
</owl:Class>

<owl:Class rdf:about="#SegmentacionRecomendada">
  <rdfs:subClassOf rdf:resource="#Recomendacion"/>
</owl:Class>

<owl:Class rdf:about="#AlertaCalidadDatos">
  <rdfs:subClassOf rdf:resource="#Recomendacion"/>
</owl:Class>


<!-- ============================================================
     INDIVIDUOS — Técnicas de visualización
     Nombres exactos del diccionario INDIVIDUAL_LABELS del backend
     ============================================================ -->

<owl:NamedIndividual rdf:about="#indTortaPastel">
  <rdf:type rdf:resource="#GraficoTortaPastel"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#indBarrasVertical">
  <rdf:type rdf:resource="#GraficoBarrasVertical"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#indBarrasHorizontal">
  <rdf:type rdf:resource="#GraficoBarrasHorizontal"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#indFrecuenciaAcumulada">
  <rdf:type rdf:resource="#GraficoFrecuenciaAcumulada"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#indTreemap">
  <rdf:type rdf:resource="#GraficoTreemap"/>
</owl:NamedIndividual>


<!-- ============================================================
     INDIVIDUOS — Recomendaciones
     ============================================================ -->

<owl:NamedIndividual rdf:about="#indAgruparMinoritarias">
  <rdf:type rdf:resource="#AgruparCategorias"/>
