</owl:DatatypeProperty>

<owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>

<owl:Class rdf:about="#ColumnaCategorica"/>

<owl:Class rdf:about="#TecnicaVisualizacion"/>

<owl:Class rdf:about="#Recomendacion"/>

<owl:Class rdf:about="#DistribucionCategorica"/>

<owl:Class rdf:about="#ColumnaBinaria">
  <rdfs:subClassOf rdf:resource="#ColumnaCategorica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColumnaCategorica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneCardinalidad"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#sugiereTecnica"/>
      <owl:hasValue rdf:resource="#indTortaPastel"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#sugiereTecnica"/>
      <owl:hasValue rdf:resource="#indBarrasHorizontal"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#ColumnaCardinalidadBaja">
  <rdfs:subClassOf rdf:resource="#ColumnaCategorica"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColumnaCategorica"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneCardinalidad"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</xsd:maxExclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <rdf:Description>
                          <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</xsd:minExclusive>
                        </rdf:Description>
                      </rdf:first>
                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#sugiereTecnica"/>
      <owl:hasValue rdf:resource="#indBarrasVertical"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

